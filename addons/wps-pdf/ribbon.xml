    <tabs>
      <tab id="localReadTranslatePdfTab" label="LocalReadTranslate">
        <group id="localReadTranslatePdfGroup" label="PDF 助手">
          <button
            id="localReadTranslateShowPdfPane"
            label="阅读与翻译"
            screentip="打开 PDF 阅读与翻译工作台"
            supertip="朗读或翻译当前 PDF 文本选区，也可识别公式并复制为 LaTeX；PDF 不写回公式。"
